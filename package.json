{
  "name": "shukannia",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web 'tsx watch apps/local-api/src/server.ts' 'vite --config apps/web/vite.config.ts'",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "start": "tsx apps/local-api/src/server.ts",
    "test": "node --test tooling/*.check.mjs && vitest run",
    "typecheck": "tsc --noEmit",
    "ingest": "tsx packages/ingest/src/cli.ts import",
    "catalog:update": "tsx packages/ingest/src/cli.ts update",
    "catalog:rollback": "tsx packages/ingest/src/cli.ts rollback",
    "demo": "tsx packages/ingest/src/cli.ts demo",
    "user:reset": "tsx packages/ingest/src/cli.ts reset-user",
    "lint": "pnpm lint:js && pnpm lint:css",
    "lint:js": "eslint . --max-warnings=0",
    "lint:css": "stylelint \"apps/**/*.css\" --max-warnings=0",
    "lint:fix": "pnpm lint:js --fix && pnpm lint:css --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck",
    "prepare": "husky"
  },
  "dependencies": {
    "@duckdb/node-api": "1.4.5-r.1",
    "@fastify/static": "^8.3.0",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.6.1",
    "kysely": "^0.28.8",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@shukannia/db": "workspace:*",
    "@shukannia/domain": "workspace:*",
    "@shukannia/ingest": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.2.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
